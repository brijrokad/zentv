<?xml version="1.0" encoding="utf-8"?>
<!-- zentv launcher (M4/M5). No uses-permission at all in the core build: CI fails if one appears.
     The weather flavour adds only INTERNET (src/weather/AndroidManifest.xml). Rule 9: the Home helper
     filters keys only, runs in its own process, has no boot receiver and never enables itself. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility without QUERY_ALL_PACKAGES: only apps that can be opened from a launcher,
         the other home apps (to step aside to the stock home), and TV inputs (HDMI tiles). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
    </queries>

    <application
        android:name=".ZentvApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zentv">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The HOME role, off by default. On the TCL the Home button reaches zentv through the helper
             (consume mode, M3a), so no second HOME app ever makes the system ask "which home?".
             `zentv launcher set-home` turns this alias on only for TVs that honour set-home-activity. -->
        <activity-alias
            android:name=".Home"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".AllAppsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".HomeKeyService"
            android:exported="false"
            android:label="@string/home_key_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":homekey">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
