# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build / packaging artifacts
build/
dist/
*.egg-info/
*.egg
wheels/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Linters / type checkers
.ruff_cache/
.mypy_cache/
.pyright/

# Environment / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# zentv: raw (unredacted) dumps never belong in the repo
*.raw.json
*.raw.txt
adbkey
adbkey.pub

# launcher build outputs and machine-local SDK path
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
launcher/.kotlin/

# Private console logos (PlayStation, Xbox, Nintendo): trademarked artwork, owner-supplied, never committed.
# Only the README stays tracked. Builds include these files in the owner's own APK only.
launcher/local-icons/*
!launcher/local-icons/README.md
